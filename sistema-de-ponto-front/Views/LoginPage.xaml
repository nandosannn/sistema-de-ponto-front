<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="sistema_de_ponto_front.Views.LoginPage">

    <VerticalStackLayout
        Padding="30"
        Spacing="20">

        <Label
            Text="Login"
            FontSize="30"
            HorizontalOptions="Center" />

        <Entry
            x:Name="CpfEntry"
            Placeholder="CPF" />

        <Entry
            x:Name="PasswordEntry"
            Placeholder="Senha"
            IsPassword="True" />

        <Button
            Text="Entrar"
            Clicked="OnLoginClicked" />

        <Label
            x:Name="MessageLabel"
            TextColor="Red" />

    </VerticalStackLayout>

</ContentPage>